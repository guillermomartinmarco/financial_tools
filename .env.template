# .env.template - Variables de entorno para financial_tools
# Generado automáticamente por `ft_setup init` desde env_list.conf
# NO EDITAR MANUALMENTE - los cambios se pierden al regenerar (usar --force)

# ============================================================
# ft_setup
# ============================================================
# Raíz del proyecto; base de todas las rutas relativas (por defecto: ancestro con .ft_root) | requerido: false
# ejemplo: C:/P/financial_tools
FT_PROJECT_ROOT="C:/P/financial_tools"

# Directorio raíz de datos de mercado | requerido: true
# ejemplo: ./data
FT_DATA_DIR="./data"

# Directorio de datos crudos descargados | requerido: true
# ejemplo: ./data/raw
FT_RAW_DIR="./data/raw"

# Directorio de datos procesados/normalizados | requerido: true
# ejemplo: ./data/processed
FT_PROCESSED_DIR="./data/processed"

# Directorio de archivos Parquet particionados | requerido: true
# ejemplo: ./data/parquet
FT_PARQUET_DIR="./data/parquet"

# Directorio de logs de la suite | requerido: true
# ejemplo: ./logs
FT_LOGS_DIR="./logs"

# Directorio de definiciones de estrategias | requerido: true
# ejemplo: ./strategies
FT_STRATEGIES_DIR="./strategies"

# Directorio de resultados de backtests/análisis | requerido: true
# ejemplo: ./results
FT_RESULTS_DIR="./results"

# Directorio compartido (tasks.db, etc.) | requerido: true
# ejemplo: ./share
FT_SHARE_DIR="./share"

# Ruta absoluta al archivo SQLite de tareas | requerido: true
# ejemplo: ./share/tasks.db
FT_TASKS_DB_PATH="./share/tasks.db"

# Host del servidor FastAPI | requerido: true
# ejemplo: 0.0.0.0
FT_API_HOST="0.0.0.0"

# Puerto del servidor FastAPI | requerido: true
# ejemplo: 8000
FT_API_PORT="8000"

# Número de workers uvicorn | requerido: false
# ejemplo: 1
FT_API_WORKERS="1"

# Nivel de logging (DEBUG, INFO, WARNING, ERROR) | requerido: false
# ejemplo: INFO
FT_LOG_LEVEL="INFO"

# ============================================================
# ft_market_data_binance
# ============================================================
# API Key de Binance (Spot/Futures) | requerido: false
# ejemplo: ***
# RELLENAR (secreto enmascarado en logs)
FT_BINANCE_API_KEY=""

# API Secret de Binance | requerido: false
# ejemplo: ***
# RELLENAR (secreto enmascarado en logs)
FT_BINANCE_API_SECRET=""

# URL base Binance Public Data Spot | requerido: false
# ejemplo: https://data.binance.vision/data/spot
FT_BINANCE_PUBLIC_DATA_BASE_URL_SPOT="https://data.binance.vision/data/spot"

# URL base Binance Public Data Futures | requerido: false
# ejemplo: https://data.binance.vision/data/futures/um
FT_BINANCE_PUBLIC_DATA_BASE_URL_FUTURES="https://data.binance.vision/data/futures/um"

# Capacidad Token Bucket Public Data | requerido: false
# ejemplo: 50
FT_BINANCE_PUBLIC_DATA_RATE_CAPACITY="50"

# Tasa recarga Token Bucket Public Data (tokens/seg) | requerido: false
# ejemplo: 10.0
FT_BINANCE_PUBLIC_DATA_RATE_REFILL_RATE="10.0"

# URL base Binance REST API Spot | requerido: false
# ejemplo: https://api.binance.com
FT_BINANCE_REST_BASE_URL_SPOT="https://api.binance.com"

# URL base Binance REST API Futures | requerido: false
# ejemplo: https://fapi.binance.com
FT_BINANCE_REST_BASE_URL_FUTURES="https://fapi.binance.com"

# Capacidad Token Bucket REST API (weight/min) | requerido: false
# ejemplo: 1200
FT_BINANCE_REST_RATE_CAPACITY="1200"

# Tasa recarga Token Bucket REST API (tokens/seg) | requerido: false
# ejemplo: 20.0
FT_BINANCE_REST_RATE_REFILL_RATE="20.0"

# Máximo reintentos REST API ante 429/5xx | requerido: false
# ejemplo: 3
FT_BINANCE_MAX_RETRIES="3"

# Backoff base en ms para retry exponencial | requerido: false
# ejemplo: 1000
FT_BINANCE_BASE_BACKOFF_MS="1000"

# Descargas simultáneas máximas (Public Data + REST) | requerido: false
# ejemplo: 5
FT_DOWNLOAD_MAX_CONCURRENT="5"

# ============================================================
# ft_market_data_yfinance
# ============================================================
# Capacidad del Token Bucket para pedidos a Yahoo Finance | requerido: false
# ejemplo: 5
FT_YFINANCE_RATE_CAPACITY="5"

# Pedidos por segundo repuestos en el Token Bucket de Yahoo | requerido: false
# ejemplo: 1.0
FT_YFINANCE_RATE_REFILL_RATE="1.0"

# Máximo reintentos ante rate-limit (429) o error de red de Yahoo | requerido: false
# ejemplo: 3
FT_YFINANCE_MAX_RETRIES="3"

# Backoff base en ms para retry exponencial contra Yahoo | requerido: false
# ejemplo: 2000
FT_YFINANCE_BASE_BACKOFF_MS="2000"

# Timeout en segundos de cada pedido a Yahoo Finance | requerido: false
# ejemplo: 30
FT_YFINANCE_TIMEOUT_S="30"

# ============================================================
# ft_data_viewer
# ============================================================
# Máximo filas para sampling aleatorio en datasets grandes | requerido: false
# ejemplo: 10000
FT_DATA_VIEWER_SAMPLE_MAX_ROWS="10000"

# Umbral en ms para reportar gaps (0 = todos) | requerido: false
# ejemplo: 0
FT_DATA_VIEWER_GAP_THRESHOLD_MS="0"

# ============================================================
# ft_indicators
# ============================================================
# Directorio Parquet Hive de indicadores técnicos (fuera de FT_PARQUET_DIR); compartido por ft_indicators y ft_ta_lib (prefijo talib_, manifiesto y bloqueo propios) | requerido: false
# ejemplo: ./data/indicators
FT_INDICATORS_DIR="./data/indicators"

# Datasets calculados en paralelo por tarea de ft_indicators y de ft_ta_lib (1-16; compartida) | requerido: false
# ejemplo: 2
FT_INDICATORS_MAX_CONCURRENT="2"

# ============================================================
# ft_datasets
# ============================================================
# Directorio versionado de recetas de datasets reales (<nombre>.toml) y sus locks (<nombre>.lock.json) | requerido: false
# ejemplo: ./datasets
FT_DATASETS_RECIPES_DIR="./datasets"

# Almacén Parquet Hive reconstruible de las recetas de ft_datasets (caché de CI; no puede anidar con FT_PARQUET_DIR) | requerido: false
# ejemplo: ./data/datasets
FT_DATASETS_DIR="./data/datasets"

# Tiempo máximo (s, >= 60) de cada subproceso de descarga lanzado por ft_datasets materialize | requerido: false
# ejemplo: 3600
FT_DATASETS_DOWNLOAD_TIMEOUT_S="3600"

# Margen de asentamiento (días, >= 1): el end de una receta debe ser <= hoy - este valor | requerido: false
# ejemplo: 7
FT_DATASETS_SETTLE_DAYS="7"

